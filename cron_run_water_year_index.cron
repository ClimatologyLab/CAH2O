#!/bin/sh
env > /home/katherine/CRONJOBS/LOGS/cron_env.log

cd /home/abatz/CAH2O

# Load the module environment
. /etc/profile.d/modules.sh
module load matlab/r2023a

# Set the PATH (if necessary)
export PATH=${PATH}:/opt/matlab/r2023a/bin/matlab:/home/katherine/CRONJOBS/WATERYEARINDEX/

# Unset DISPLAY for headless operation
unset DISPLAY

# Run MATLAB script
nohup matlab -nodesktop -nodisplay</home/abatz/CAH2O/process_cah2o_ensemble_update.m>/home/katherine/CRONJOBS/LOGS/water_year_index_matlab.out &
